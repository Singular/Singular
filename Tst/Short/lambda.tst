LIB "tst.lib";
tst_init();

// Parenthesized and computed htable keys keep their ordinary meaning.
string key="actual";
htable parenthesized=htable((key)->1);
ASSUME(0,parenthesized["actual"]==1);
htable computed=htable(string(5)->2);
ASSUME(0,computed["5"]==2);
htable nested=htable((string(2+3))->3);
ASSUME(0,nested["5"]==3);

// Lambda-looking text inside comments must not affect normal expressions.
ASSUME(0,(1 /* ) -> {} */ + 2)==3);
ASSUME(0,(1 // ) -> {}
  + 2)==3);
int hashbang=(1
#! ) -> { }
  + 2);
ASSUME(0,hashbang==3);
int midline_hashbang=(1 #! ) -> { }
  + 2);
ASSUME(0,midline_hashbang==3);
ring compatibility=0,t,dp;
ASSUME(0,(8/2)==4);
ASSUME(0,(t /* comment */ /2)==t/2);

// A failed ordinary-expression probe may also exceed Flex's 16 KiB buffer.
ASSUME(0,(1 /**/ + 2)==3);
// Whitespace and the character after '-' are restored on fallback.
ASSUME(0,(8) - (3)==5);
ASSUME(0,(8)
  + (3)==11);
// An ambiguous identifier-starting fallback may span an input-buffer refill.
int probe_value=7;
ASSUME(0,(probe_value
  + 1)==8);

// Legacy lambdas retain implicit returns, also after intermediate statements.
proc single=x->{x*x};
ASSUME(0,single(6)==36);
intvec squares=apply(1..3,x->{x*x});
ASSUME(0,squares==intvec(1,4,9));
proc steps=x->{int a=x+1;a*a};
ASSUME(0,steps(5)==36);
proc text=s->{size(s)};
ASSUME(0,text("abcdef")==6);
// The printed name of the legacy lambda remains part of its output.
single;
// Empty, typed, and untyped parameter lists.
proc empty=()->{return(7)};
ASSUME(0,empty()==7);
proc add=(int a, int b)->{return(a+b)};
ASSUME(0,add(3,4)==7);
// Keep the complete parameter text in the generated diagnostic name.
add;
// regress.cmd pipes this outer test, so intended-success multiline headers use
// execute's in-memory input; seekable-file coverage is exercised separately.
// Whitespace is accepted on both sides of the arrow.
execute("proc spaced=(int a, int b)
  ->
  {return(a-b)};");
ASSUME(0,spaced(7,4)==3);
proc commented=(int /* argument */ a)->{return(a+1);};
ASSUME(0,commented(4)==5);
execute("proc linecomment=(int // argument
  a)->{return(a+1);};");
ASSUME(0,linecomment(4)==5);
proc mix=(a, string b)->{return(string(a)+b)};
ASSUME(0,mix(7,"x")=="7x");
// Conditions, intermediate statements, and implicit NONE return.
proc first=(list l)->{if(size(l)==0){return(0);} return(l[1]);};
ASSUME(0,first(list(5))==5);
ASSUME(0,first(list())==0);
proc noreturn=(int a)->{int b=a+1;};
noreturn(6);
// Newlines and trailing line comments in the body.
proc tail=()->{return(9); // trailing comment
};
ASSUME(0,tail()==9);
proc tailnone=()->{int unused=9; // trailing comment
};
tailnone();
// Variadic and alias arguments behave like regular procs.
proc count=(list #)->{return(size(#))};
ASSUME(0,count()==0);
ASSUME(0,count(1,2,"three")==3);
proc compact_count=(list#)->{return(size(#))};
ASSUME(0,compact_count(1,2)==2);
proc prefixed=(int a, list #)->{return(a+size(#))};
ASSUME(0,prefixed(5,1,2,3)==8);
proc aliased=(alias int a)->{return(a+1);};
int v=6;
ASSUME(0,aliased(v)==7);
// Lambdas as arguments and nested lambda construction.
squares=apply(1..3,(int x)->{return(x*x)});
ASSUME(0,squares==intvec(1,4,9));
proc make=()->{return((int a,int b)->{return(a*b)});};
proc product=make();
ASSUME(0,product(3,4)==12);
proc invoke=(proc f,int x)->{return(f(x));};
ASSUME(0,invoke((int x)->{return(x+1)},7)==8);
// Multiple-line parameter list after first argument.
execute("proc multiline=(int a,
int b)->{return(a+b);};");
ASSUME(0,multiline(2,3)==5);
execute("proc leading_newline=(
int a)->{return(a+1);};");
ASSUME(0,leading_newline(4)==5);
string dynamic_name="dynamic_argument";
proc computed_name=(int `string(dynamic_name)`)->{return(dynamic_argument+1);};
ASSUME(0,computed_name(4)==5);
package LambdaParams;
proc qualified_name=(LambdaParams::qualified_argument)->{return(qualified_argument+1);};
ASSUME(0,qualified_name(5)==6);
string qualified_dynamic_name="qualified_computed_argument";
proc qualified_computed_name=(LambdaParams::`string(qualified_dynamic_name)`)->{return(qualified_computed_argument+1);};
ASSUME(0,qualified_computed_name(6)==7);
proc qualified_typed=(int Current::qualified_typed_argument)->{return(qualified_typed_argument+1);};
ASSUME(0,qualified_typed(7)==8);
proc qualified_variadic=(list Top::#)->{return(size(#));};
ASSUME(0,qualified_variadic(1,2,3)==3);
proc qualified_alias=(alias int Top::qualified_alias_argument)->{return(qualified_alias_argument+1);};
int qualified_alias_value=8;
ASSUME(0,qualified_alias(qualified_alias_value)==9);
// Parameter text may exceed both the old 1023-byte lookahead and Flex's 16 KiB buffer.
execute("proc long_parameters=(int /**/ a)->{return(a+1);};");
ASSUME(0,long_parameters(4)==5);
// Ring-dependent parameters and returns.
ring r=0,(x,y),dp;
proc polys=(poly a,poly b)->{return(a*b)};
ASSUME(0,polys(x+y,x-y)==x2-y2);
// Matrix dimensions use the same full expression syntax as named procs.
matrix dimension_arg[5][5];
proc dimensions=(matrix M[(2+3)][size("abcde")])->{return(nrows(M)+ncols(M));};
ASSUME(0,dimensions(dimension_arg)==10);
matrix hashbang_arg[5][1];
execute("proc hashbang_parameter=(matrix M[(2
#! ignored inside the formal parameter header
+3)][1])->{return(nrows(M));};");
ASSUME(0,hashbang_parameter(hashbang_arg)==5);
matrix qualified_matrix_arg[2][1];
proc qualified_matrix=(matrix Top::qualified_matrix_parameter[2][1])->{return(nrows(qualified_matrix_parameter));};
ASSUME(0,qualified_matrix(qualified_matrix_arg)==2);
kill single,steps,text,empty,add,spaced,commented,linecomment,mix,first,noreturn,tail,tailnone,count,compact_count,prefixed,aliased,make,product,invoke,multiline,leading_newline,computed_name,qualified_name,qualified_computed_name,qualified_typed,qualified_variadic,qualified_alias,qualified_alias_value,qualified_dynamic_name,LambdaParams,long_parameters,polys,dimensions,hashbang_parameter,dimension_arg,hashbang_arg,qualified_matrix,qualified_matrix_arg;
// Keep each formal identifier within the downstream omalloc bin invariant.
proc formal_word_boundary=(int )->{return(5);};
ASSUME(0,formal_word_boundary(4)==5);
kill formal_word_boundary;
// One byte beyond the limit must be rejected without losing execute input.
execute("proc overlong_formal=(int )->{return(6);}; overlong_formal(4);");
int resumed_after_overlong_formal=1;
ASSUME(0,resumed_after_overlong_formal==1);

// Computed identifiers are not restricted to the scanner's direct-word
// lookahead limit.  Their cleanup must use the allocator that owns them.
string computed_long_name="";
int computed_long_index;
for (computed_long_index=1;computed_long_index<=1008;computed_long_index++)
{
  computed_long_name=computed_long_name+"q";
}
// On the usual 4 KiB-page build, procedure metadata crosses the normal-bin
// limit here.  A portable all-page-size case follows below.
execute("proc "+computed_long_name+"(){return(13);};");
execute("ASSUME(0,"+computed_long_name+"()==13);");
execute("kill "+computed_long_name+";");
proc computed_long_lambda=(int `string(computed_long_name)`)->
{
  return(`string(computed_long_name)`+1);
};
ASSUME(0,computed_long_lambda(4)==5);
ASSUME(0,computed_long_lambda(9)==10);
proc computed_long_named(int `string(computed_long_name)`)
{
  return(`string(computed_long_name)`+2);
};
ASSUME(0,computed_long_named(5)==7);
int `computed_long_name`=11;
int computed_long_value=`computed_long_name`;
ASSUME(0,computed_long_value==11);
kill `computed_long_name`,computed_long_value,computed_long_lambda,computed_long_named;

// Map metadata copies the current ring name and must use the same generic
// cleanup path for computed names.  Exercise destruction, replacement,
// conversion, list cleanup, and expression-list assignment.
ring `computed_long_name`=0,(long_map_variable),dp;
map computed_long_map;
kill computed_long_map;
map computed_long_map_left;
map computed_long_map_right;
computed_long_map_left=computed_long_map_right;
kill computed_long_map_left,computed_long_map_right;
map computed_long_map_conversion;
ideal computed_long_map_ideal=ideal(computed_long_map_conversion);
kill computed_long_map_ideal,computed_long_map_conversion;
map computed_long_map_list_value;
list computed_long_map_list=computed_long_map_list_value;
kill computed_long_map_list_value,computed_long_map_list;
map computed_long_map_exprlist;
computed_long_map_exprlist=basering,long_map_variable;
kill computed_long_map_exprlist;
setring r;
kill `computed_long_name`;

for (computed_long_index=1009;computed_long_index<=9000;computed_long_index++)
{
  computed_long_name=computed_long_name+"q";
}
proc computed_very_long=(int `string(computed_long_name)`)->
{
  return(`string(computed_long_name)`+3);
};
ASSUME(0,computed_very_long(6)==9);
// 9000 characters exceed OM_MAX_BLOCK_SIZE for every supported omalloc page
// size.  Procedure metadata and the symbol table duplicate this name and both
// copies must remain valid bin allocations through destruction.
execute("proc "+computed_long_name+"(){return(13);};");
execute("ASSUME(0,"+computed_long_name+"()==13);");
execute("kill "+computed_long_name+";");
kill computed_very_long,computed_long_name,computed_long_index;

// Long legacy names must also be safe to destroy.
proc longlegacy=x->{size("")};
ASSUME(0,longlegacy(0)==2048);
kill longlegacy;

// An unfinished parenthesis in execute() must return to the outer input.
execute("(1");
int resumed_after_eof=1;
ASSUME(0,resumed_after_eof==1);
execute("(probe_value");
int resumed_after_identifier_eof=1;
ASSUME(0,resumed_after_identifier_eof==1);

// STRINGTOK must not be reused as a parameter-list token, and malformed
// empty argument slots must report an error without hanging the parser.
execute("proc raw_head=\"int x\"->{return(1);};");
execute("proc malformed=(int a,,int b)->{return(a+b);}; malformed(1,2);");
int resumed_after_bad_lambda=1;
ASSUME(0,resumed_after_bad_lambda==1);

print("lambda tests passed");
tst_status(1);$
