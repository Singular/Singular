///////////////////////////////////////////////////////////////////////////////
version="version rwborder.lib 4.4.1.0 Sep_2026 ";
category="Noncommutative";
info="
LIBRARY: rwborder.lib  Border bases in the rational Weyl algebra

OVERVIEW:
This library computes the border basis associated to the standard differential
monomials of a finite-rank left ideal in the rational Weyl algebra
K(x)<D>.  Computations stay fraction-free in the polynomial Weyl algebra.

PROCEDURES:
  rationalWeylBorderBasis(I,n[,eng]);
      compute a rational Weyl border basis from generators I
  rationalWeylBorderBasisFromGB(G,n);
      compute it from a rational Groebner basis G
  kernelBorderBasis(I);
      kernel reimplementation of the commutative construction

RETURN VALUE:
The procedures return a list.  Its first entry is the border basis and its
second entry is the order ideal.  A returned relation
  a(x)*b - sum c_t(x)*t
represents the monic rational relation obtained by division by a(x).

REFERENCES:
  C. Rodriguez, A.-L. Sattelberger: Border Bases in the Rational Weyl
  Algebra, Advances in Applied Mathematics 177 (2026), 103065.
";

LIB "nctools.lib";
LIB "ratgb.lib";

proc kernelBorderBasis(ideal I)
"USAGE:   kernelBorderBasis(I); I is a zero-dimensional ideal
RETURN:  list: [1] the border basis, [2] its order ideal
PURPOSE: Compute the border basis associated to the standard monomials of I
         using the kernel implementation.
ASSUME:  The basering is commutative and has a global ordering.
EXAMPLE: example kernelBorderBasis; shows an example
"
{
  ideal G=std(I);
  return(system("kernelBorderBasis",G));
}
example
{
  "EXAMPLE:"; echo=2;
  ring r=0,(x,y),dp;
  ideal I=x2-y,y2-x;
  list B=kernelBorderBasis(I);
  B[1]; // border basis
  B[2]; // order ideal
}

static proc requireRationalWeylRing(int n)
{
  if (!system("with","ratGB"))
  {
    ERROR("rational Weyl border bases require a build configured with --with-ratGB");
  }
  if (char(basering)!=0)
  {
    ERROR("rational Weyl border bases currently require characteristic zero");
  }
  if ((n<=0)||(2*n!=nvars(basering)))
  {
    ERROR("expected variables (x(1..n),D(1..n)) and n coordinate variables");
  }
  if (!isWeyl())
  {
    ERROR("the basering is not a Weyl algebra");
  }
}

proc rationalWeylBorderBasisFromGB(ideal G, int n)
"USAGE:   rationalWeylBorderBasisFromGB(G,n); G a rational Groebner basis,
         n the number of coordinate variables
RETURN:  list: [1] a fraction-free border basis, [2] its differential order ideal
PURPOSE: Compute the border basis associated to the standard differential
         monomials of the rational Groebner basis G.
ASSUME:  The basering is the n-th polynomial Weyl algebra with variables
         (x(1..n),D(1..n)) and a global antiblock ordering.  G is represented
         fraction-free in this polynomial Weyl algebra.
NOTE:    A relation a(x)*b-sum(c_t(x)*t) represents the corresponding monic
         relation in K(x)<D> after division by a(x).
EXAMPLE: example rationalWeylBorderBasis; shows an example
"
{
  requireRationalWeylRing(n);
  return(system("rationalWeylBorderBasis",G,n));
}

proc rationalWeylBorderBasis(ideal I, int n, list #)
"USAGE:   rationalWeylBorderBasis(I,n[,eng]); I an ideal, n the number of
         coordinate variables, eng an optional Groebner-basis engine flag
RETURN:  list: [1] a fraction-free border basis, [2] its differential order ideal
PURPOSE: Compute the border basis of the finite-rank left ideal generated by I
         in the rational Weyl algebra K(x(1),...,x(n))<D(1),...,D(n)>.
ASSUME:  The basering is the n-th polynomial Weyl algebra with variables
         (x(1..n),D(1..n)) and a global antiblock ordering as required by
         ratstd.
NOTE:    The optional engine flag is passed to ratstd.  The value 1 selects
         std; the default selects slimgb.
EXAMPLE: example rationalWeylBorderBasis; shows an example
"
{
  requireRationalWeylRing(n);

  def @presentation=basering;
  if (size(#)>0)
  {
    @presentation=ratstd(I,n,#[1]);
  }
  else
  {
    @presentation=ratstd(I,n);
  }
  return(system("rationalWeylBorderBasis",pGBid,n));
}
example
{
  "EXAMPLE:"; echo=2;
  if (!system("with","ratGB"))
  {
    "This example requires a build configured with --with-ratGB.";
  }
  else
  {
    ring r=0,(x,D),(a(0,1),dp);
    def W=Weyl(); setring W;
    ideal I=x*D-1;
    list B=rationalWeylBorderBasis(I,1);
    B[1]; // x*D-1 represents D-1/x in Q(x)<D>
    B[2]; // 1
  }
}
