proc surface_generic_bielliptic_d15_pi21(list #) "USAGE: surface_generic_bielliptic_d15_pi21([lambda,mu]); RETURN: generic bielliptic quotient-cover data. MATHEMATICS: finite free quotient of product of elliptic curves. EXAMPLE: ring r=31991,(dummy),dp; list S=surface_generic_bielliptic_d15_pi21();" { return(surface_generic_bielliptic_cover_data(#)); }
