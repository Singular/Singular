// Properly elliptic labels
proc surface_generic_elliptic_d7_pi6(list #) "USAGE: surface_generic_elliptic_d7_pi6([lambda,bound]); RETURN: generic properly elliptic surface. MATHEMATICS: E x C with C a smooth plane quartic; Kodaira dimension 1. EXAMPLE: ring r=31991,(dummy),dp; list S=surface_generic_elliptic_d7_pi6();" { return(surface_generic_elliptic_surface(#)); }
