///////////////////////////////////////////////////////////////////////////////
version="version nonGeneralTypeSurfacesP4.lib 0.1.0 Aug_2026";
category="Algebraic Geometry";
info="
LIBRARY: nonGeneralTypeSurfacesP4.lib

PURPOSE:
  A fixed catalogue of 48 surfaces of non-general type in projective four-space:
  rational, elliptic ruled, Enriques-type, K3-type, bielliptic, abelian and
  properly elliptic surfaces. The labels describe birational surface types;
  an embedded surface need not itself be a minimal model.

  These are concrete stored equations, not random representatives of the
  same type or coordinate changes of them.
  The field, variable order, coefficients and generator order are retained.
  This is a finite collection of examples, not an exhaustive classification
  of surfaces or a parametrization of their construction families.
  For random geometric constructions see surface_type_generics.lib instead.

FIELDS:
  The two bielliptic examples use F_911; enriques_d11_pi10 uses F_43 with
  variables (v,w,x,y,z); the other 45 use F_31991 with variables (x,y,z,u,v).
  The loader always constructs the original field, independently of the caller's
  current ring. There is no implicit change of characteristic.

DATA:
  The generated block records the source-file provenance and licence notice.
  These identify the data files used for the import, not the mathematical
  origin of the catalogue. misc/import_non_general_type_surfaces_p4.py
  reproduces the import, retaining each source file's SHA-256.
  No external software, data files or network access is needed at runtime.
  Loading an example does not test smoothness or reclassify it.

PROCEDURES:
  nonGeneralTypeSurfaceP4Names(); list the 48 stored example names
  nonGeneralTypeSurfaceP4(name); load a ring containing ideal surfaceIdeal

EXAMPLE:
  LIB \"nonGeneralTypeSurfacesP4.lib\";
  nonGeneralTypeSurfaceP4Names();
  def R=nonGeneralTypeSurfaceP4(\"bordiga\");
  setring R;
  surfaceIdeal;
";

proc nonGeneralTypeSurfaceP4Names()
"USAGE:   nonGeneralTypeSurfaceP4Names();
RETURN:  list of all 48 fixed catalogue names, grouped by surface type.
NOTE:    These names refer to concrete stored ideals, not generic constructors.
         Load a named example with nonGeneralTypeSurfaceP4(name).
EXAMPLE: list N=nonGeneralTypeSurfaceP4Names(); size(N); N[4];
SEE ALSO: nonGeneralTypeSurfaceP4
"
{
  list catalogueLabels=
    "cubic_scroll","veronese","castelnuovo","bordiga",
    "rational_d7_pi4","rational_d8_pi5","rational_d8_pi6",
    "rational_d9_pi6","rational_d9_pi7","rational_d10_pi8",
    "rational_d10_pi9_quart_1","rational_d10_pi9_quart_2",
    "rational_d11_pi11_ss_0","rational_d11_pi11_ss_1",
    "rational_d11_pi11_ss_inf","quintic_elliptic_scroll",
    "enriques_d9_pi6","enriques_d10_pi8","enriques_d11_pi10",
    "enriques_d13_pi16","enriques_d13_pi16_two",
    "k3_d7_pi5","k3_d8_pi6","k3_d9_pi8","k3_d10_pi9_quart_1",
    "k3_d10_pi9_quart_2","k3_d11_pi11_ss_0","k3_d11_pi11_ss_1",
    "k3_d11_pi11_ss_2","k3_d11_pi11_ss_3","k3_d11_pi12",
    "k3_d12_pi14","k3_d13_pi16","k3_d14_pi19",
    "bielliptic_d10_pi6","bielliptic_d15_pi21","abelian_d10_pi6",
    "abelian_d15_pi21_quintic_3","abelian_d15_pi21_quintic_1",
    "elliptic_d7_pi6","elliptic_d8_pi7","elliptic_d9_pi7",
    "elliptic_d10_pi9","elliptic_d10_pi10","elliptic_d11_pi12",
    "elliptic_d12_pi13","elliptic_d12_pi14_ss_0","elliptic_d12_pi14_ss_inf";
  return(catalogueLabels);
}

proc nonGeneralTypeSurfaceP4(string name)
"USAGE:   nonGeneralTypeSurfaceP4(name); name from nonGeneralTypeSurfaceP4Names()
RETURN:  a polynomial ring R with the exported homogeneous ideal surfaceIdeal.
         Use def R=nonGeneralTypeSurfaceP4(name); setring R; to access the ideal.
PURPOSE: Load a fixed non-general-type surface in P^4 from the stored catalogue.
         Its prime field, variable order, coefficients and ordered generators
         agree with the source example. The returned ring uses dp ordering.
NOTE:    The caller's field is not used: bielliptic examples use F_911,
         enriques_d11_pi10 uses F_43, and the other examples use F_31991.
         Unknown names raise an error. No random numbers are consumed.
         No smoothness or surface-type computation is performed on loading.
         The ideal attributes catalogueName, catalogueType and sourceSHA256
         record the source label, birational type and SHA-256 of its .mrdi file.
         A basering is not required. The caller's ring and objects are preserved.
         The returned ring remains valid when this command is used in a wrapper.
EXAMPLE: def R=nonGeneralTypeSurfaceP4(\"bordiga\"); setring R; surfaceIdeal;
SEE ALSO: nonGeneralTypeSurfaceP4Names
"
{
  // Ring-independent data lookup rejects unknown names before creating a ring.
  list data=nonGeneralTypeSurfaceP4Data(name);
  string variableNames=data[2][1];
  int j;
  for(j=2;j<=size(data[2]);j=j+1)
  {
    variableNames=variableNames+","+data[2][j];
  }
  execute("ring R="+string(data[1])+",("+variableNames+"),dp;");
  ideal surfaceIdeal;
  for(j=1;j<=size(data[3]);j=j+1)
  {
    execute("surfaceIdeal["+string(j)+"]="+data[3][j]+";");
  }
  attrib(surfaceIdeal,"catalogueName",name);
  attrib(surfaceIdeal,"catalogueType",nonGeneralTypeSurfaceP4Type(name));
  attrib(surfaceIdeal,"sourceSHA256",data[4]);
  export(surfaceIdeal);
  return(R);
}

static proc nonGeneralTypeSurfaceP4Type(string name)
{
  // Catalogue metadata only; the data lookup has already validated the name.
  if(name=="cubic_scroll" || name=="veronese" || name=="castelnuovo"
     || name=="bordiga" || find(name,"rational_")==1)
  { return("rational"); }
  if(name=="quintic_elliptic_scroll") { return("elliptic_ruled"); }
  if(find(name,"enriques_")==1) { return("Enriques"); }
  if(find(name,"k3_")==1) { return("K3"); }
  if(find(name,"bielliptic_")==1) { return("bielliptic"); }
  if(find(name,"abelian_")==1) { return("abelian"); }
  if(find(name,"elliptic_")==1) { return("elliptic"); }
  ERROR("nonGeneralTypeSurfaceP4: missing catalogue type for '"+name+"'");
}

