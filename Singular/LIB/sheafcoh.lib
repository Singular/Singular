// Run the multiplication-table algorithm and build its typed result from a
// frame which has already been validated or canonically constructed.
static proc sectionBasisMultTableSpace(module M,int d,ideal IX,list T,list #)
{
  if (size(#)>3)
  {
    ERROR("expected at most tail degree, denominator, and verification flag");
  }
  list B;
  if (size(#)==0)
  {
    B=sectionBasisTrustedTrivializedBasis(M,d,T[1],T[2]);
  }
  if (size(#)==1)
  {
    B=sectionBasisTrustedTrivializedBasis(M,d,T[1],T[2],#[1]);
  }
  if (size(#)==2)
  {
    B=sectionBasisTrustedTrivializedBasis(M,d,T[1],T[2],#[1],#[2]);
  }
  if (size(#)==3)
  {
    B=sectionBasisTrustedTrivializedBasis(M,d,T[1],T[2],#[1],#[2],#[3]);
  }
  if ((B[2]==0) || (!homog(B[2])))
  {
    ERROR("internal error: the section denominator is zero or nonhomogeneous");
  }
  module supportModule=IX;
  attrib(supportModule,"isHomog",intvec(0));
  if (!sectionBasisRegularDenominator(supportModule,B[2]))
  {
    ERROR("the scalar section denominator is a zero divisor on the support");
  }
  int i;
  for (i=1; i<=size(B[1]); i++)
  {
    if ((B[1][i]==0) || (!homog(B[1][i])) ||
        (deg(B[1][i])-deg(B[2])!=d+T[3]))
    {
      ERROR("internal error: invalid scalar section degree");
    }
  }
  SectionSpace V;
  V.over=basering;
  V.presentation=M;
  V.supportIdeal=IX;
  V.basis=B[1];
  V.denom=B[2];
  V.trivializationImages=T[1];
  V.trivializationDenom=T[2];
  V.twist=d;
  V.trivializationShift=T[3];
  V.tailDegree=B[3];
  return(V);
}

proc rankOneSheafSectionBasis(def data,int d,list #)
"USAGE:   rankOneSheafSectionBasis(M,d,I[,s,g,v]); M module,
         d,s int, I ideal, g poly, v int
         rankOneSheafSectionBasis(F,d[,s,g,v]); F RankOneSheaf
ASSUME:   I is the homogeneous coordinate ideal of the support of coker(M),
         whose associated sheaf is torsion-free and generically of rank one,
         and M has its row degrees assigned as isHomog.
RETURN:   SectionSpace V. The entries V[i] are Section objects forming a
         basis of global sections of the twist d. Their rational
         representatives are V.basis[i]/V.denom; V.tailDegree records the
         multiplication-tail degree used.
NOTE:     The procedure chooses a homogeneous rational trivialization and
         computes the section basis in one call. It applies both to line
         bundles and to rank-one torsion-free sheaves which are not locally
         free, including non-invertible divisorial sheaves. To supply a known
         trivialization instead, call
         trivializedSectionBasis directly. The optional tail arguments are
         passed unchanged to sheafSectionBasis.
         Frame recovery follows rankOneTrivialization: supported SpaSM is
         selected on certified integral support, and the original graded-dual
         method otherwise. Full frame validation is retained; a selected
         SpaSM computation is not retried with another method.
         For a RankOneSheaf, its cached frame is used directly, with no frame
         recovery or repeated frame validation. The same F can be used
         for any integer twist d. Verification is off unless v is explicitly
         nonzero.
SEE ALSO: lineBundleSectionBasis, rankOneSheafSectionBasisLinear,
          sectionBasis, rationalMapFromSections, rankOneTrivialization,
          trivializedSectionBasis, sheafSectionBasis
EXAMPLE: example rankOneSheafSectionBasis; shows an example
"
{
  if (typeof(data)=="RankOneSheaf")
  {
    if (size(#)>3)
    {
      ERROR("expected at most tail degree, denominator, and verification flag");
    }
    RankOneSheaf F=data;
    sectionBasisRequireCachedFrame(F);
    list T=list(F.trivializationImages,F.trivializationDenom,
                F.trivializationShift);
    if (size(#)==0)
    {
      return(sectionBasisMultTableSpace(F.presentation,d,F.supportIdeal,T));
    }
    if (size(#)==1)
    {
      return(sectionBasisMultTableSpace(F.presentation,d,F.supportIdeal,T,
                                        #[1]));
    }
    if (size(#)==2)
    {
      return(sectionBasisMultTableSpace(F.presentation,d,F.supportIdeal,T,
                                        #[1],#[2]));
    }
    return(sectionBasisMultTableSpace(F.presentation,d,F.supportIdeal,T,
                                      #[1],#[2],#[3]));
  }
  if (typeof(data)!="module")
  {
    ERROR("expected a module or a RankOneSheaf");
  }
  if ((size(#)<1) || (size(#)>4) || (typeof(#[1])!="ideal"))
  {
    ERROR("expected M,d,I followed by at most tail degree, denominator, and verification flag");
  }
  module M=data;
  ideal IX=#[1];
  list T=rankOneTrivialization(M,IX);
  if (size(#)==1)
  {
    return(sectionBasisMultTableSpace(M,d,IX,T));
  }
  if (size(#)==2)
  {
    return(sectionBasisMultTableSpace(M,d,IX,T,#[2]));
  }
  if (size(#)==3)
  {
    return(sectionBasisMultTableSpace(M,d,IX,T,#[2],#[3]));
  }
  return(sectionBasisMultTableSpace(M,d,IX,T,#[2],#[3],#[4]));
}
example
{"EXAMPLE:";
  echo=2;
  ring R=0,(u,v,w),dp;
  ideal IX=u*v;
  // This rank-one torsion-free sheaf on Proj(R/IX) is not locally free at
  // the intersection of its two components:
  module M=v*gen(1),u*gen(2);
  attrib(M,"isHomog",intvec(0,0));
  SectionSpace V=rankOneSheafSectionBasis(M,0,IX);
  V;
  V[1];
}

proc lineBundleSectionBasis(def data,int d,list #)
"USAGE:   lineBundleSectionBasis(M,d,I[,s,g,v]); M module,
         d,s int, I ideal, g poly, v int
         lineBundleSectionBasis(F,d[,s,g,v]); F RankOneSheaf
ASSUME:   I is the homogeneous coordinate ideal of the support of coker(M),
         whose associated sheaf is a line bundle, and M has its row degrees
         assigned as isHomog.
RETURN:   SectionSpace V containing a basis of global sections of the twist d.
         The i-th Section is V[i], represented by V.basis[i]/V.denom.
NOTE:     This is the line-bundle name for rankOneSheafSectionBasis and has
         the same implementation, automatic frame-backend selection, and
         optional arguments. Local freeness is an input assumption; this alias
         does not test it separately. A cached F avoids frame rediscovery and
         can be reused at every twist.
SEE ALSO: rankOneSheafSectionBasis, lineBundleSectionBasisLinear,
          sectionBasis, rationalMapFromSections, sheafSectionBasis,
          trivializedSectionBasis
EXAMPLE: example lineBundleSectionBasis; shows an example
"
{
  if (size(#)==0) { return(rankOneSheafSectionBasis(data,d)); }
  if (size(#)==1) { return(rankOneSheafSectionBasis(data,d,#[1])); }
  if (size(#)==2)
  {
    return(rankOneSheafSectionBasis(data,d,#[1],#[2]));
  }
  if (size(#)==3)
  {
    return(rankOneSheafSectionBasis(data,d,#[1],#[2],#[3]));
  }
  if (size(#)==4)
  {
    return(rankOneSheafSectionBasis(data,d,#[1],#[2],#[3],#[4]));
  }
  ERROR("too many arguments for lineBundleSectionBasis");
}
example
{"EXAMPLE:";
  echo=2;
  ring R=0,(x,y,z),dp;
  // e2=x*e1 presents O(1). Compute its sections in one call:
  module M=-x*gen(1)+gen(2);
  attrib(M,"isHomog",intvec(-1,0));
  SectionSpace V=lineBundleSectionBasis(M,0,ideal(0));
  V;
  // Extract one Section, or the whole basis as a list of Sections:
  Section s=V[1];
  s;
  list B=sectionBasis(V);
  // Singular represents a projective rational map by its homogeneous
  // coordinate ideal; the common section denominator cancels:
  ideal phi=rationalMapFromSections(V);
  phi;
  // A list of Sections defines the corresponding subsystem:
  rationalMapFromSections(list(V[1],V[3]));
}

proc rankOneSheafSectionBasisLinear(module M,int d,ideal IX,list #)
"USAGE:   rankOneSheafSectionBasisLinear(M,d,I[,s,g,v]); M module,
         d,s int, I ideal, g poly, v int
ASSUME:   I defines a nonempty integral homogeneous support, the sheafification
         of coker(M) is torsion-free and generically of rank one, and M has its
         row degrees assigned as isHomog.
RETURN:   SectionSpace V containing a scalar rational basis of global sections
         of the twist d.
NOTE:     This is the complete one-call section algorithm using finite linear
         algebra for frame recovery and multiplication tables for the section
         computation. Frame nullspaces always use Singular's exact generic
         module kernel. Use rankOneSheafSectionBasisSpaSM to request strict
         exact SpaSM nullspaces; no backend substitution occurs.
         No graded Hom module or saturation-based frame certificate is
         computed. Unlike the automatic rankOneSheafSectionBasis(M,d,I), this
         command never probes SpaSM or tests support integrality. Correctness
         relies on the integral-support, torsion-free, and rank-one assumptions above,
         which are not checked. Verification is off unless v is explicitly
         nonzero. For several twists, construct F=rankOneSheafLinear(M,I) once
         and call rankOneSheafSectionBasis(F,d) repeatedly instead.
SEE ALSO: rankOneSheafSectionBasisSpaSM, lineBundleSectionBasisLinear,
          rankOneSheafLinear,
          rankOneSheafSectionBasis, rankOneTrivializationLinear,
          rankOneSheafSectionBasisMultTable, rationalMapFromSections
EXAMPLE: example rankOneSheafSectionBasisLinear; shows an example
"
{
  if (size(#)>3)
  {
    ERROR("expected at most tail degree, denominator, and verification flag");
  }
  RankOneSheaf F=rankOneSheafLinear(M,IX);
  if (size(#)==0) { return(rankOneSheafSectionBasis(F,d)); }
  if (size(#)==1) { return(rankOneSheafSectionBasis(F,d,#[1])); }
  if (size(#)==2)
  {
    return(rankOneSheafSectionBasis(F,d,#[1],#[2]));
  }
  return(rankOneSheafSectionBasis(F,d,#[1],#[2],#[3]));
}
example
{"EXAMPLE:";
  echo=2;
  ring R=32003,(x,y,z),dp;
  // e2=x*e1 presents O(1). Frame recovery uses Singular's module kernel.
  module M=-x*gen(1)+gen(2);
  attrib(M,"isHomog",intvec(-1,0));
  SectionSpace V=rankOneSheafSectionBasisLinear(M,0,ideal(0));
  V;
  rationalMapFromSections(V);
}

